module -- shake: keep-all

import SE.OperationalIdentity

/-!
# Example: Revisions of One Rule

SETest.OperationalIdentity.Example

Three records are successive revisions of one rule. The declaration licenses each
revision step as a continuation, so it treats all three as the same.

Two surfaces are examined. One assigns an identifier from a rule key shared by
all revisions: it is faithful. The other assigns an identifier from a version
field that changes on every revision: it is not, and the divergence is carried
by one licensed step.

The example is finite and checked by computation. It exhibits the mechanics of
the audit. It does not say that a version field is a faulty mechanism, or that
the licence is warranted.
-/

namespace SETest.OperationalIdentity.Example

open SE.Persistence SE.OperationalIdentity

/-- Each step revises one record into the next. -/
def revisions : Dynamics Unit (Fin 3) where
  step _ x y := y.val = x.val + 1

/-- The declaration licenses every revision step as a continuation. -/
def licenseAll : Licence Unit (Fin 3) where
  licensed _ _ _ := True

/-- The declared relation: the identity generated by the licensed steps. -/
def declared : Declared (Fin 3) :=
  Declared.ofLicence licenseAll revisions

theorem declared_zero_one : declared.rel 0 1 :=
  Generated.rel ⟨(), rfl, trivial⟩

theorem declared_one_two : declared.rel 1 2 :=
  Generated.rel ⟨(), rfl, trivial⟩

theorem declared_zero_two : declared.rel 0 2 :=
  Generated.trans declared_zero_one declared_one_two

/-- The identifier is assigned from a rule key shared by every revision. -/
def ruleKey : Surface (Fin 3) Nat where
  Value := Unit
  mechanism _ := ()
  uses := [fun _ => 0]
  controlled u hu _ _ _ := by
    simp at hu
    subst hu
    rfl

/-- The identifier is assigned from a version field that changes on every revision. -/
def versionKey : Surface (Fin 3) Nat where
  Value := Fin 3
  mechanism r := r
  uses := [fun r => r.val]
  controlled u hu _ _ h := by
    simp at hu
    subst hu
    exact congrArg Fin.val h

/-- Check 1: the rule-key surface never splits a declared class. -/
theorem ruleKey_faithful_on_declared_pair (r s : Fin 3) (_ : declared.rel r s) :
    ruleKey.SameTreatment r s :=
  rfl

/-- Check 2: the version-field surface separates the first revision from the second. -/
theorem versionKey_witness :
    DivergenceWitness declared.rel versionKey.SameTreatment 0 1 :=
  ⟨declared_zero_one, fun h => absurd h (by decide)⟩

/-- Check 3: the witness refutes faithfulness. -/
theorem versionKey_not_faithful : ¬ declared.FaithfulTo versionKey :=
  versionKey_witness.not_faithful

/-- Check 4: the separation is carried by a difference in the mechanism's value. -/
theorem versionKey_witness_mechanism_ne : versionKey.mechanism 0 ≠ versionKey.mechanism 1 :=
  Declared.witness_mechanism_ne versionKey_witness

/-- Check 5: the divergence is localized to a single licensed step. -/
theorem versionKey_localized :
    ∃ t x y, revisions.step t x y ∧ licenseAll.licensed t x y ∧
      ¬ versionKey.SameTreatment x y ∧ versionKey.mechanism x ≠ versionKey.mechanism y :=
  exists_licensed_step_divergence licenseAll revisions versionKey versionKey_not_faithful

/--
The record surface, which Lean admits but no implementation discloses, diverges
from any declaration that merges two distinct records. This is why the audit's
mechanism registry is a precondition of the method.
-/
theorem record_surface_diverges : ¬ declared.FaithfulTo (Surface.record (Fin 3)) := by
  intro h
  have h01 := (Declared.faithfulTo_record_iff declared).1 h 0 1 declared_zero_one
  exact absurd h01 (by decide)

/-- The store of both surfaces is not faithful, because one of its surfaces is not. -/
theorem store_not_faithful :
    ¬ Faithful declared.rel (StoreTreatment [ruleKey, versionKey]) :=
  fun h => versionKey_not_faithful
    ((faithful_store_iff declared.rel [ruleKey, versionKey]).1 h versionKey (by simp))

/-- The declared relation holds on every pair of the three records. -/
def allSame (_ _ : Fin 3) : Prop := True

instance : DecidableRel allSame := fun _ _ => instDecidableTrue

theorem declared_zero_all (r : Fin 3) : declared.rel 0 r := by
  match r with
  | ⟨0, _⟩ => exact Generated.refl _
  | ⟨1, _⟩ => exact declared_zero_one
  | ⟨2, _⟩ => exact declared_zero_two

theorem declared_iff_allSame (r s : Fin 3) : declared.rel r s ↔ allSame r s :=
  ⟨fun _ => trivial, fun _ =>
    Generated.trans (Generated.symm (declared_zero_all r)) (declared_zero_all s)⟩

/-- Check 6: the finite audit passes the rule-key surface when the assumptions are established. -/
theorem audit_ruleKey :
    audit true (List.finRange 3) allSame ruleKey.SameTreatment = Verdict.pass := by
  decide

/-- The finite audit fails the version-field surface and finds the witness. -/
theorem audit_versionKey :
    audit true (List.finRange 3) allSame versionKey.SameTreatment = Verdict.fail := by
  decide

theorem findWitness_versionKey :
    findWitness (List.finRange 3) allSame versionKey.SameTreatment = some (0, 1) := by
  decide

/-- Without established assumptions the verdict is indeterminate, not a pass. -/
theorem audit_unwarranted :
    audit false (List.finRange 3) allSame ruleKey.SameTreatment = Verdict.indeterminate := by
  decide

end SETest.OperationalIdentity.Example
