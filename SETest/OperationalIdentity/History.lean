module -- shake: keep-all

import SE.OperationalIdentity

/-!
# Example: A Pass Is Lost When the Generating Pairs Grow

SETest.OperationalIdentity.History

A surface passes against the identity generated by one licensed step. Extend the
generating pairs by a second licensed step and the same surface, over the same
three records, no longer passes: the extension merges a declared class and
creates a witness among records the audit had already examined.

A passing verdict is relative to the declaration it was computed against.
-/

namespace SETest.OperationalIdentity.History

open SE.Persistence SE.OperationalIdentity

/-- One licensed step: `0` continues as `1`. -/
def stepsBefore (x y : Fin 3) : Prop := x = 0 ∧ y = 1

/-- The same step, extended by `1` continuing as `2`. -/
def stepsAfter (x y : Fin 3) : Prop := (x = 0 ∧ y = 1) ∨ (x = 1 ∧ y = 2)

/-- A surface that separates the last record from the others. -/
def isolateLast : Surface (Fin 3) Bool where
  Value := Bool
  mechanism r := decide (r.val = 2)
  uses := [fun r => decide (r.val = 2)]
  controlled u hu _ _ h := by
    simp at hu
    subst hu
    exact h

theorem extends_before (x y : Fin 3) (h : stepsBefore x y) : stepsAfter x y :=
  Or.inl h

theorem pass_before : Faithful (Generated stepsBefore) isolateLast.SameTreatment := by
  refine (faithful_generated_iff_generators isolateLast.sameTreatment_equivalence).2 ?_
  rintro x y ⟨rfl, rfl⟩
  decide

theorem fail_after : ¬ Faithful (Generated stepsAfter) isolateLast.SameTreatment := by
  intro h
  have h' := (faithful_generated_iff_generators isolateLast.sameTreatment_equivalence).1 h
    1 2 (Or.inr ⟨rfl, rfl⟩)
  exact absurd h' (by decide)

/-- A pass is not monotone under extension of the generating pairs. -/
theorem pass_not_monotone :
    (∀ x y, stepsBefore x y → stepsAfter x y) ∧
    Faithful (Generated stepsBefore) isolateLast.SameTreatment ∧
    ¬ Faithful (Generated stepsAfter) isolateLast.SameTreatment :=
  ⟨extends_before, pass_before, fail_after⟩

/-- The other direction holds: faithfulness to the larger relation gives faithfulness to the smaller. -/
theorem pass_after_gives_before
    (h : Faithful (Generated stepsAfter) isolateLast.SameTreatment) :
    Faithful (Generated stepsBefore) isolateLast.SameTreatment :=
  faithful_generated_anti_mono extends_before h

end SETest.OperationalIdentity.History
