module

public import SE.Persistence.Relation.Licence

set_option autoImplicit false

/-!
# Declared Identity

SE.OperationalIdentity.Declared

A declared identity relation is an input to the audit: an equivalence relation
on a carrier, supplied together with whatever justifies it.

This module does not decide whether the relation identifies real-world
referents, and it does not decide how the relation is derived. It only records
the equivalence property that the later comparison needs, and it offers the
constructors that Persistence already justifies:

- `Declared.ofGenerators`: the equivalence generated by asserted pairs;
- `Declared.ofLicence`: the identity generated by the steps a licence licenses,
  which may depend on the step and not only on its operator;
- `Declared.ofClassification`: the identity generated by the steps of preserving
  operators.

Identity construction belongs to Persistence. A classification-derived relation
is the operator-level special case of a licence-derived one
(`ofClassification_rel_eq_ofLicence_rel`).

A transformation classified neutral or inapplicable licenses nothing by
that classification alone. Whether a neutral step continues identity is a
question for the licence, not for this module.

Persistence states its calculus for carriers in `Type`, so this module does the
same.
-/

namespace SE.OperationalIdentity

open SE.Persistence

@[expose] public section

variable {R : Type}

-- RR.DEFINES: OI.TYPE.DECLARED
/-- A declared identity relation: an equivalence relation on the carrier `R`, supplied as an input. -/
structure Declared (R : Type) where
  /-- `rel r s`: the declaration treats `r` and `s` as the same. -/
  rel : R → R → Prop
  /-- The declaration is an equivalence relation. -/
  equivalence : Equivalence rel

-- RR.DEFINES: OI.DEF.DECLARED_OF_GENERATORS
/-- The declared relation generated by asserted pairs. -/
def Declared.ofGenerators (P : R → R → Prop) : Declared R where
  rel := Generated P
  equivalence := Generated.equivalence P

-- RR.DEFINES: OI.DEF.DECLARED_OF_LICENCE
/-- The declared relation generated by the steps of a dynamics that a licence licenses. -/
def Declared.ofLicence {T : Type} (L : Licence T R) (d : Dynamics T R) : Declared R where
  rel := L.identityRel d
  equivalence := L.identityRel_equivalence d

-- RR.DEFINES: OI.DEF.DECLARED_OF_CLASSIFICATION
/-- The declared relation generated by the steps of the preserving operators of a classification. -/
def Declared.ofClassification {T : Type} (c : Classification T) (d : Dynamics T R) :
    Declared R where
  rel := c.identityRel d
  equivalence := c.identityRel_equivalence d

-- RR.DEFINES: OI.THM.DECLARED_OF_LICENCE_REL_EQ_GENERATED
/-- A licence-derived declaration is generated by exactly the licensed steps. -/
theorem Declared.ofLicence_rel_eq {T : Type} (L : Licence T R) (d : Dynamics T R) :
    (Declared.ofLicence L d).rel = Generated (L.stepRel d) :=
  rfl

-- RR.DEFINES: OI.THM.DECLARED_OF_CLASSIFICATION_REL_EQ_OF_LICENCE_REL
/-- A classification-derived declaration is the licence-derived one for the licence the classification gives. -/
theorem Declared.ofClassification_rel_eq_ofLicence_rel {T : Type}
    (c : Classification T) (d : Dynamics T R) :
    (Declared.ofClassification c d).rel = (Declared.ofLicence (c.toLicence R) d).rel :=
  (Classification.toLicence_identityRel c d).symm

end

end SE.OperationalIdentity
