module

public import SE.OperationalIdentity.Faithfulness
public import SE.Persistence.Commitment.Observed

set_option autoImplicit false

/-!
# Faithfulness over Generated Identity

SE.OperationalIdentity.Licensed

How the audit relates to the Persistence calculus.

Persistence owns the construction of identity relations. This module adds no
construction. It states, in the language of Persistence, what faithfulness of a
surface means when the declared relation is generated.

- Faithfulness to a generated relation is consistency, in the Persistence sense,
  of the generating pairs with the pairs the surface separates
  (`faithful_generated_iff_consistent`).
- For a classification, a surface's signature is a presentation, and
  faithfulness is soundness of that presentation
  (`faithfulTo_ofClassification_iff_presentationSound`). Those results are
  Persistence's. This module only identifies them.
- Because treatment is an equivalence, a surface is faithful to a generated
  relation exactly when it does not separate the endpoints of any single
  generating pair (`faithful_generated_iff_generators`). So a divergence
  can always be localized to one licensed step
  (`exists_licensed_step_divergence`), and the separation is carried by a
  difference in the mechanism value at its endpoints.

That localization needs treatment to be transitive. It holds for the treatment
relations of surfaces, which are kernels of signatures, and for any equivalence.
It does not hold for an arbitrary relation.

What is new here is the step-level audit: a step the declaration licenses as a
continuation, whose endpoints the implementation treats differently, is a finite
object an operator can inspect.
-/

namespace SE.OperationalIdentity

open SE.Persistence

@[expose] public section

variable {R O : Type}

-- RR.DEFINES: OI.THM.FAITHFUL_GENERATED_IFF_GENERATORS
/--
When the treatment relation is an equivalence, faithfulness to a generated
relation is checked on the generating pairs.
-/
theorem faithful_generated_iff_generators {P O : R → R → Prop} (hO : Equivalence O) :
    Faithful (Generated P) O ↔ ∀ x y, P x y → O x y := by
  constructor
  · intro h x y hp
    exact h x y (Generated.rel hp)
  · intro h x y hg
    exact Generated.le_of_equivalence hO h hg

-- RR.DEFINES: OI.THM.FAITHFUL_GENERATED_IFF_CONSISTENT
/--
Faithfulness to a generated relation is consistency of the generating pairs with
the pairs asserted separated.
-/
theorem faithful_generated_iff_consistent {P O : R → R → Prop} :
    Faithful (Generated P) O ↔ Consistent P (fun x y => ¬ O x y) := by
  constructor
  · intro h x y hn hg
    exact hn (h x y hg)
  · intro h x y hg
    exact Classical.byContradiction fun hn => h x y hn hg

-- RR.DEFINES: OI.THM.SURFACE_FAITHFUL_GENERATED_IFF_CONSISTENT
/--
A surface is faithful to the relation generated by `P` exactly when `P` is
consistent with the pairs the surface's signature separates.
-/
theorem Surface.faithful_generated_iff_consistent (d : Surface R O) (P : R → R → Prop) :
    Faithful (Generated P) d.SameTreatment ↔ Consistent P (SeparatedBy d.signature) :=
  SE.OperationalIdentity.faithful_generated_iff_consistent

-- RR.DEFINES: OI.THM.FAITHFUL_TO_OF_CLASSIFICATION_IFF_PRESENTATION_SOUND
/--
For the declaration a classification generates, faithfulness of a surface is
soundness of its signature as a presentation.
-/
theorem faithfulTo_ofClassification_iff_presentationSound {T : Type}
    (c : Classification T) (dyn : Dynamics T R) (d : Surface R O) :
    (Declared.ofClassification c dyn).FaithfulTo d ↔
      c.PresentationSound dyn d.signature :=
  Iff.rfl

-- RR.DEFINES: OI.THM.FAITHFUL_TO_OF_LICENCE_IFF_STEPS
/--
A surface is faithful to the identity a licence generates exactly when it treats
the endpoints of every licensed step the same.
-/
theorem faithfulTo_ofLicence_iff_steps {T : Type} (L : Licence T R) (dyn : Dynamics T R)
    (d : Surface R O) :
    (Declared.ofLicence L dyn).FaithfulTo d ↔
      ∀ t x y, dyn.step t x y → L.licensed t x y → d.SameTreatment x y := by
  unfold Declared.FaithfulTo Declared.ofLicence
  change Faithful (Generated (L.stepRel dyn)) d.SameTreatment ↔ _
  rw [faithful_generated_iff_generators d.sameTreatment_equivalence]
  constructor
  · intro h t x y hs hl
    exact h x y ⟨t, hs, hl⟩
  · rintro h x y ⟨t, hs, hl⟩
    exact h t x y hs hl

-- RR.DEFINES: OI.THM.EXISTS_LICENSED_STEP_DIVERGENCE
/--
If a surface is not faithful to the identity a licence generates, one licensed
step accounts for it: the declaration licenses the step as a continuation, the
surface treats its endpoints differently, and the mechanism's values differ there.
-/
theorem exists_licensed_step_divergence {T : Type} (L : Licence T R) (dyn : Dynamics T R)
    (d : Surface R O) (h : ¬ (Declared.ofLicence L dyn).FaithfulTo d) :
    ∃ t x y, dyn.step t x y ∧ L.licensed t x y ∧ ¬ d.SameTreatment x y ∧
      d.mechanism x ≠ d.mechanism y := by
  rw [faithfulTo_ofLicence_iff_steps] at h
  refine Classical.byContradiction fun hno => h ?_
  intro t x y hs hl
  refine Classical.byContradiction fun hn => hno ⟨t, x, y, hs, hl, hn, ?_⟩
  exact d.mechanism_ne_of_not_sameTreatment hn

-- RR.DEFINES: OI.THM.FAITHFUL_GENERATED_ANTI_MONO
/--
More generating pairs make faithfulness harder: faithfulness to a larger
generated relation gives faithfulness to a smaller one.
-/
theorem faithful_generated_anti_mono {P P' O : R → R → Prop}
    (hP : ∀ x y, P x y → P' x y) (h : Faithful (Generated P') O) :
    Faithful (Generated P) O :=
  fun x y hg => h x y (Generated.mono hP hg)

end

end SE.OperationalIdentity
