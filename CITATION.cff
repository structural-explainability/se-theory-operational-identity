type: software

title: "SE Theory: Operational Identity"
version: "0.3.0"
date-released: "2026-05-02"

authors:
  - family-names: Case
    given-names: Denise M.
    orcid: "https://orcid.org/0000-0001-6165-7389"
    affiliation: "Northwest Missouri State University, School of Computer Science and Information Systems, Maryville, MO, USA"

repository-code: "https://github.com/structural-explainability/se-theory-operational-identity"
